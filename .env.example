# Copy this file to .env and fill in at least one key. Never share or upload .env.

# Which AI writes the answers: claude, gemini (free) or openai
AI_PROVIDER=claude

# Groq, free and fastest at writing down meeting speech (about half a second): https://console.groq.com/keys
# Optional but recommended: aiHelper switches between Groq and Gemini if one hits its free limit.
GROQ_API_KEY=

# Google Gemini, free: https://aistudio.google.com/apikey
# Also used to hear meeting audio when AI_PROVIDER is claude (Claude can't listen to audio).
GEMINI_API_KEY=

# OpenAI: https://platform.openai.com/api-keys (needs API credit)
OPENAI_API_KEY=

# Claude (Anthropic): https://console.anthropic.com/settings/keys (needs API credit)
ANTHROPIC_API_KEY=
