{
  "name": "aihelper",
  "productName": "aiHelper",
  "version": "1.0.1",
  "private": true,
  "description": "A private AI call assistant: hears your meeting, suggests answers in an overlay hidden from screen sharing, writes notes, and runs mock interviews.",
  "author": "aryann2611",
  "main": "overlay.js",
  "scripts": {
    "start": "node server.js",
    "overlay": "electron overlay.js",
    "test": "node test.js",
    "dist": "electron-builder --win nsis"
  },
  "engines": {
    "node": ">=22"
  },
  "build": {
    "appId": "com.aryann2611.aihelper",
    "productName": "aiHelper",
    "files": [
      "overlay.js",
      "overlay-preload.js",
      "overlay.html",
      "server.js",
      "ai.js",
      "sessions.js",
      "app.js",
      "md.js",
      "index.html",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "aiHelper-Setup.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "openai": "^7.59.0"
  }
}
